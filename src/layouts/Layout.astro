---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "AgentHub - AI 에이전트 스킬, MCP 도구 & 플러그인 디렉토리", 
  description = "오픈소스 AI 에이전트 스킬, Model Context Protocol (MCP) 서버, 브라우저 확장 프로그램, 플러그인을 발견하고 공유하세요. 데이터베이스 없이 커뮤니티 기반으로 운영됩니다."
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- SEO Optimization -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph / Social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AgentHub - AI 에이전트 도구 디렉토리" />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@agenthub" />
    
    <!-- Naver / Daum SEO -->
    <meta name="keywords" content="AI 에이전트, MCP 서버, 에이전트 스킬, 플러그인, 오픈소스, Claude, Gemini" />
    <meta property="og:locale" content="ko_KR" />
  </head>
  <body>
    <!-- Background glowing ambient blobs -->
    <div class="glow-blob glow-cyan"></div>
    <div class="glow-blob glow-violet"></div>
    
    <!-- Header component -->
    <Header />
    
    <!-- Main page wrapper -->
    <main>
      <slot />
    </main>
    
    <!-- Footer component -->
    <Footer />
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 80px - 200px); /* header & footer spacing */
    padding-top: 100px; /* offset for fixed header */
    padding-bottom: 60px;
  }
</style>
