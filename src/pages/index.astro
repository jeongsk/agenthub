---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { Search, Compass, Terminal, Cpu, Sparkles } from '@lucide/astro';

// Fetch all tools from local content directory
let skills = [];
try {
  skills = await getCollection('skills');
} catch (e) {
  // Gracefully handle empty collection before samples are created
  skills = [];
}

// Sort: featured first, then alphabetical
const sortedSkills = [...skills].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const categories = [
  { id: 'all', label: 'All Assets', icon: Compass },
  { id: 'mcp-server', label: 'MCP Servers', icon: Server => Terminal }, // Lucide map
  { id: 'agent-skill', label: 'Agent Skills', icon: Sparkles },
  { id: 'plugin', label: 'Plugins', icon: Cpu }
];
---

<Layout 
  title="AgentHub - Skills, MCP Tools & Plugins Directory"
  description="Discover, explore, and share open-source Model Context Protocol (MCP) servers, Agent skills, and custom AI plugins. Simple, fast, and database-free."
>
  <div class="container main-container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge">
        <Sparkles size={14} class="rose-icon" />
        <span>The Agentic Era Registry</span>
      </div>
      <h1 class="hero-title">
        The Open-Source Skill Registry for <span class="text-gradient">AI Agents</span>
      </h1>
      <p class="hero-subtitle">
        Find, copy, and install powerful Model Context Protocol (MCP) servers, plugins, and custom skills to supercharge Claude, Gemini, Cursor, and beyond.
      </p>
    </section>

    <!-- Search & Filters Panel -->
    <section class="search-filter-section glass-panel">
      <div class="search-bar-wrapper">
        <Search size={20} class="search-icon" />
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search skills, tools, categories, command..." 
          class="glass-input search-input-field"
          autocomplete="off"
        />
      </div>
      
      <div class="category-tabs">
        <button class="tab-btn active" data-category="all" id="tab-all">
          <Compass size={16} />
          <span>All Assets</span>
        </button>
        <button class="tab-btn" data-category="mcp-server" id="tab-mcp">
          <Terminal size={16} />
          <span>MCP Servers</span>
        </button>
        <button class="tab-btn" data-category="agent-skill" id="tab-skill">
          <Sparkles size={16} />
          <span>Agent Skills</span>
        </button>
        <button class="tab-btn" data-category="plugin" id="tab-plugin">
          <Cpu size={16} />
          <span>Plugins</span>
        </button>
      </div>
    </section>

    <!-- Directory Grid -->
    <section class="directory-section">
      <div class="section-header">
        <h2 id="directory-heading" class="section-title">Registry Explorer</h2>
        <span class="results-count" id="results-count">{sortedSkills.length} assets available</span>
      </div>
      
      {sortedSkills.length === 0 ? (
        <div class="empty-state glass-card">
          <Terminal size={48} class="muted-icon" />
          <h3>No assets found</h3>
          <p>We are just getting started! Be the first to submit a skill or MCP tool.</p>
          <a href="/submit" class="btn-grad">Add First Skill</a>
        </div>
      ) : (
        <div class="directory-grid" id="directory-grid">
          {sortedSkills.map((skill) => (
            <div 
              class="grid-item" 
              data-title={skill.data.title.toLowerCase()}
              data-description={skill.data.description.toLowerCase()}
              data-tags={skill.data.tags.join(',').toLowerCase()}
              data-category={skill.data.category}
              data-featured={skill.data.featured ? "true" : "false"}
            >
              <Card 
                title={skill.data.title}
                description={skill.data.description}
                category={skill.data.category}
                tags={skill.data.tags}
                author={skill.data.author}
                compatibleAgents={skill.data.compatibleAgents}
                icon={skill.data.icon}
                slug={skill.slug}
              />
            </div>
          ))}
        </div>
      )}
      
      <!-- Live Search Fallback empty state -->
      <div class="empty-state glass-card hide" id="no-search-results">
        <Search size={48} class="muted-icon" />
        <h3>No matching skills found</h3>
        <p>Try checking your spelling or adjusting your filters.</p>
      </div>
    </section>
  </div>
</Layout>

<!-- Client Side Dynamic Searching & Filtering Script -->
<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const tabButtons = document.querySelectorAll('.tab-btn');
  const gridItems = document.querySelectorAll('.grid-item');
  const resultsCount = document.getElementById('results-count');
  const noResultsState = document.getElementById('no-search-results');
  const directoryGrid = document.getElementById('directory-grid');

  let activeCategory = 'all';
  let searchQuery = '';

  function filterItems() {
    let visibleCount = 0;

    gridItems.forEach((itemNode) => {
      const item = itemNode as HTMLElement;
      const title = item.getAttribute('data-title') || '';
      const description = item.getAttribute('data-description') || '';
      const tags = item.getAttribute('data-tags') || '';
      const category = item.getAttribute('data-category') || '';
      
      const matchesSearch = 
        title.includes(searchQuery) || 
        description.includes(searchQuery) || 
        tags.includes(searchQuery);
      
      const matchesCategory = 
        activeCategory === 'all' || 
        category === activeCategory;

      if (matchesSearch && matchesCategory) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Update count indicator
    if (resultsCount) {
      resultsCount.textContent = `${visibleCount} asset${visibleCount === 1 ? '' : 's'} found`;
    }

    // Toggle Empty state
    if (visibleCount === 0) {
      if (directoryGrid) directoryGrid.style.display = 'none';
      if (noResultsState) noResultsState.classList.remove('hide');
    } else {
      if (directoryGrid) directoryGrid.style.display = 'grid';
      if (noResultsState) noResultsState.classList.add('hide');
    }
  }

  // Search input handler
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterItems();
    });
  }

  // Category Tab handler
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      // Remove active from all tabs
      tabButtons.forEach((b) => b.classList.remove('active'));
      
      // Set active on clicked
      const currentTarget = e.currentTarget as HTMLButtonElement;
      currentTarget.classList.add('active');
      
      // Update filter criteria
      activeCategory = currentTarget.getAttribute('data-category') || 'all';
      filterItems();
    });
  });
</script>

<style>
  .main-container {
    padding-top: 40px;
  }

  /* Hero Section */
  .hero-section {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    color: rgb(251, 113, 133);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 24px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rose-icon {
    color: hsl(var(--rose-point));
    fill: hsl(var(--rose-point));
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 850;
    line-height: 1.15;
    margin-bottom: 20px;
    letter-spacing: -0.04em;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: hsl(var(--text-secondary));
    line-height: 1.6;
    font-weight: 400;
  }

  /* Search & Filter section */
  .search-filter-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    margin-bottom: 50px;
  }

  .search-bar-wrapper {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: hsl(var(--text-muted));
    pointer-events: none;
  }

  .search-input-field {
    width: 100%;
    padding-left: 54px !important;
    font-size: 1.1rem;
    height: 56px;
    border-radius: 14px;
  }

  .category-tabs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tab-btn {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: hsl(var(--text-secondary));
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    color: white;
    transform: translateY(-1px);
  }

  .tab-btn.active {
    background: white;
    color: hsl(var(--bg-base));
    border-color: white;
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0.25);
  }

  /* Directory list */
  .directory-section {
    margin-bottom: 80px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 12px;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
  }

  .results-count {
    color: hsl(var(--text-muted));
    font-size: 0.9rem;
  }

  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 60px 40px;
    gap: 16px;
  }

  .empty-state.hide {
    display: none;
  }

  .muted-icon {
    color: hsl(var(--text-muted));
    opacity: 0.5;
  }

  .empty-state h3 {
    font-size: 1.3rem;
    color: white;
  }

  .empty-state p {
    color: hsl(var(--text-secondary));
    max-width: 400px;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    
    .directory-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
