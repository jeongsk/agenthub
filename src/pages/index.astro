---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import * as Icons from '@lucide/astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_IDS } from '../lib/registry';

const skillEntries = await getCollection('skills');
const sortedSkills = [...skillEntries]
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    const starDifference = b.data.githubStars - a.data.githubStars;
    if (starDifference !== 0) return starDifference;
    return a.data.title.localeCompare(b.data.title, 'ko-KR');
  });

interface TabDef {
  id: string;
  label: string;
  icon: any;
}
const categoryTabs: TabDef[] = CATEGORY_IDS.map((cid) => {
  const cfg = CATEGORIES[cid];
  const IconCmp = (Icons as any)[cfg.icon] || Icons.Terminal;
  return { id: cid, label: cfg.label, icon: IconCmp };
});
---

<Layout
  title="AgentHub - AI 에이전트 도구 & 리소스 디렉토리"
  description="오픈소스 MCP 서버, 에이전트 스킬, 하네스, 유틸리티, 플러그인, 브라우저 확장을 발견하고 공유하세요. 데이터베이스가 필요 없는 GitHub PR 기반 레지스트리입니다."
>
  <div class="container main-container">
    <section class="hero-section">
      <div class="hero-badge">
        <Icons.Sparkles size={14} class="rose-icon" />
        <span>AI 에이전트 레지스트리</span>
      </div>
      <h1 class="hero-title">
        <span class="text-gradient">AI 에이전트</span>를 위한<br />
        오픈소스 도구 디렉토리
      </h1>
      <p class="hero-subtitle">
        MCP 서버, 에이전트 스킬, 프레임워크, 하네스, 컴포넌트, 데스크톱 유틸리티, CLI 유틸리티, 플러그인, 브라우저 확장을 한곳에서 찾아보세요.
      </p>
    </section>

    <section class="search-filter-section glass-panel">
      <div class="search-bar-wrapper">
        <Icons.Search size={20} class="search-icon" />
        <input
          type="text"
          id="search-input"
          placeholder="스킬, 도구, 작성자, 태그 검색..."
          class="glass-input search-input-field"
          autocomplete="off"
        />
        <button type="button" id="clear-search" class="search-clear-btn" aria-label="검색어 지우기" hidden>
          <Icons.X size={14} />
        </button>
      </div>

      <div class="category-tabs">
        <button class="tab-btn active" data-category="all" id="tab-all">
          <Icons.Compass size={16} />
          <span>전체</span>
        </button>
        {categoryTabs.map((tab) => (
          <button class="tab-btn" data-category={tab.id} id={`tab-${tab.id}`}>
            <tab.icon size={16} />
            <span>{tab.label}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="directory-section">
      <div class="section-header">
        <h2 id="directory-heading" class="section-title">레지스트리 탐색</h2>
        <span class="results-count" id="results-count">불러오는 중...</span>
      </div>

      <div class="directory-grid" id="directory-grid">
        {sortedSkills.map((skill) => (
          <div
            class="grid-item"
            data-title={skill.data.title.toLowerCase()}
            data-description={skill.data.description.toLowerCase()}
            data-tags={skill.data.tags.join(' ').toLowerCase()}
            data-author={skill.data.author.toLowerCase()}
            data-agents={skill.data.compatibleAgents.join(' ').toLowerCase()}
            data-category={skill.data.category}
          >
            <Card
              title={skill.data.title}
              description={skill.data.description}
              category={skill.data.category}
              tags={skill.data.tags}
              author={skill.data.author}
              compatibleAgents={skill.data.compatibleAgents}
              icon={skill.data.icon}
              slug={skill.id}
              stars={skill.data.githubStars}
            />
          </div>
        ))}
      </div>

      <div class="empty-state glass-card hide" id="no-search-results">
        <Icons.Search size={48} class="muted-icon" />
        <h3>검색 결과가 없습니다</h3>
        <p>철자를 확인하거나 필터를 조정해보세요.</p>
      </div>
    </section>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const clearSearchButton = document.getElementById('clear-search') as HTMLButtonElement;
  const tabButtons = document.querySelectorAll('.tab-btn');
  const gridItems = document.querySelectorAll('.grid-item');
  const directoryGrid = document.getElementById('directory-grid');
  const resultsCount = document.getElementById('results-count');
  const noResultsState = document.getElementById('no-search-results');
  const directoryStateKey = 'agenthub:directory-state';
  const returnToDirectoryKey = 'agenthub:return-to-directory';

  let activeCategory = 'all';
  let searchQuery = '';

  function normalizeQuery(value: string | null) {
    return (value || '').toLowerCase().trim();
  }

  function getAvailableCategories() {
    return Array.from(tabButtons)
      .map((button) => (button as HTMLButtonElement).dataset.category)
      .filter(Boolean) as string[];
  }

  function getInitialState() {
    const params = new URLSearchParams(window.location.search);
    const availableCategories = getAvailableCategories();
    const storedState = sessionStorage.getItem(directoryStateKey);
    let storedQuery = '';
    let storedCategory = 'all';

    if (storedState) {
      try {
        const parsedState = JSON.parse(storedState) as { query?: string; category?: string };
        storedQuery = normalizeQuery(parsedState.query || '');
        storedCategory = parsedState.category || 'all';
      } catch {
        sessionStorage.removeItem(directoryStateKey);
      }
    }

    const category = params.get('category') || storedCategory;

    return {
      query: normalizeQuery(params.get('q') || storedQuery),
      category: availableCategories.includes(category) ? category : 'all',
    };
  }

  function persistState() {
    const state = { query: searchQuery, category: activeCategory };
    sessionStorage.setItem(directoryStateKey, JSON.stringify(state));
    sessionStorage.setItem(returnToDirectoryKey, `${window.location.pathname}${window.location.search}`);
  }

  function updateUrlState() {
    const params = new URLSearchParams();
    if (searchQuery) params.set('q', searchQuery);
    if (activeCategory !== 'all') params.set('category', activeCategory);

    const queryString = params.toString();
    const nextUrl = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
    window.history.replaceState(null, '', nextUrl);
  }

  function activateTab(category: string) {
    tabButtons.forEach((entry) => {
      const button = entry as HTMLButtonElement;
      button.classList.toggle('active', button.dataset.category === category);
    });
  }

  function syncClearSearchButton() {
    if (!clearSearchButton || !searchInput) return;
    clearSearchButton.hidden = searchInput.value.trim().length === 0;
  }

  function filterItems() {
    let visibleCount = 0;

    gridItems.forEach((itemNode) => {
      const item = itemNode as HTMLElement;
      const searchable = [
        item.dataset.title,
        item.dataset.description,
        item.dataset.tags,
        item.dataset.author,
        item.dataset.agents,
      ].join(' ');
      const matchesSearch = searchable.includes(searchQuery);
      const matchesCategory = activeCategory === 'all' || item.dataset.category === activeCategory;
      const isVisible = matchesSearch && matchesCategory;

      item.classList.toggle('hide', !isVisible);
      if (isVisible) visibleCount += 1;
    });

    if (resultsCount) resultsCount.textContent = `${visibleCount}개`;
    if (!directoryGrid || !noResultsState) return;

    directoryGrid.classList.toggle('hide', visibleCount === 0);
    noResultsState.classList.toggle('hide', visibleCount !== 0);
  }

  function applyState({ query, category }: { query: string; category: string }) {
    searchQuery = query;
    activeCategory = category;
    if (searchInput) searchInput.value = query;
    syncClearSearchButton();
    activateTab(category);
    updateUrlState();
    persistState();
    filterItems();
  }

  if (searchInput) {
    searchInput.addEventListener('input', (event) => {
      searchQuery = (event.target as HTMLInputElement).value.toLowerCase().trim();
      updateUrlState();
      persistState();
      filterItems();
      syncClearSearchButton();
    });
  }

  if (clearSearchButton && searchInput) {
    clearSearchButton.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      syncClearSearchButton();
      updateUrlState();
      persistState();
      filterItems();
      searchInput.focus();
    });
  }

  tabButtons.forEach((button) => {
    button.addEventListener('click', (event) => {
      tabButtons.forEach((entry) => entry.classList.remove('active'));
      const currentTarget = event.currentTarget as HTMLButtonElement;
      currentTarget.classList.add('active');
      activeCategory = currentTarget.dataset.category || 'all';
      updateUrlState();
      persistState();
      filterItems();
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.card-link').forEach((link) => {
    link.addEventListener('click', () => {
      persistState();
    });
  });

  applyState(getInitialState());
</script>

<style>
  .main-container { padding-top: 40px; }
  .hero-section {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    color: rgb(251, 113, 133);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 24px;
  }
  .rose-icon { color: hsl(var(--rose-point)); }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 850;
    line-height: 1.12;
    margin-bottom: 20px;
    text-wrap: balance;
  }
  .hero-subtitle {
    font-size: 1.15rem;
    color: hsl(var(--text-secondary));
    line-height: 1.6;
  }
  .search-filter-section {
    padding: 18px;
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 34px;
  }
  .search-bar-wrapper { position: relative; flex: 1; min-width: 0; }
  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: hsl(var(--text-muted));
  }
  .search-input-field { width: 100%; padding-left: 48px; padding-right: 44px; }
  .search-clear-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    width: 24px;
    height: 24px;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    color: hsl(var(--text-secondary));
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .search-clear-btn:hover,
  .search-clear-btn:focus-visible {
    color: white;
    border-color: rgba(6, 182, 212, 0.35);
    background: rgba(6, 182, 212, 0.16);
  }
  .search-clear-btn:focus-visible {
    outline: 2px solid rgba(6, 182, 212, 0.5);
    outline-offset: 2px;
  }
  .search-clear-btn[hidden] { display: none; }
  .category-tabs { display: flex; gap: 8px; flex-wrap: wrap; min-width: 0; }
  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: hsl(var(--text-secondary));
    border-radius: 10px;
    padding: 10px 12px;
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    min-width: 0;
  }
  .tab-btn.active, .tab-btn:hover {
    color: white;
    border-color: rgba(6, 182, 212, 0.35);
    background: rgba(6, 182, 212, 0.08);
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .section-title { font-size: 1.5rem; }
  .results-count { color: hsl(var(--text-muted)); font-size: 0.95rem; }
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .hide { display: none !important; }
  .empty-state {
    padding: 54px 24px;
    text-align: center;
  }
  .empty-state h3 { margin: 14px 0 8px; }
  .empty-state p { color: hsl(var(--text-secondary)); margin-bottom: 18px; }
  .muted-icon { color: hsl(var(--text-muted)); }
  @media (max-width: 992px) {
    .directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .search-filter-section { flex-direction: column; align-items: stretch; }
  }
  @media (max-width: 640px) {
    .main-container {
      padding-top: 28px;
    }
    .hero-section {
      margin-bottom: 36px;
    }
    .hero-title {
      font-size: 2.1rem;
      overflow-wrap: keep-all;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
    .search-filter-section {
      padding: 14px;
      gap: 12px;
    }
    .directory-grid { grid-template-columns: 1fr; }
    .category-tabs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .tab-btn {
      width: 100%;
      justify-content: center;
      padding: 10px 8px;
      min-height: 46px;
      min-width: 0;
      text-align: center;
    }

    .tab-btn span {
      min-width: 0;
      white-space: normal;
      text-align: center;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
  }

  @media (max-width: 390px) {
    .hero-title {
      font-size: 1.95rem;
    }
    .section-title {
      font-size: 1.35rem;
    }
  }
</style>
