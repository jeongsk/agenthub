---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import * as Icons from '@lucide/astro';
import { ArrowLeft, Copy, Check, Calendar, User } from '@lucide/astro';
import GitHub from '../../components/icons/GitHub.astro';

// Dynamic routing paths generation
export async function getStaticPaths() {
  let skills = [];
  try {
    skills = await getCollection('skills');
  } catch (e) {
    skills = [];
  }
  
  return skills.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, tags, author, githubUrl, installCommand, compatibleAgents, icon } = entry.data;

// Resolve Lucide Icon
const IconComponent = (Icons as any)[icon] || Icons.Terminal;

const categoryLabels = {
  'mcp-server': 'MCP Server',
  'agent-skill': 'Agent Skill',
  'plugin': 'Plugin',
  'browser-extension': 'Extension'
};

const badgeClasses = {
  'mcp-server': 'badge-mcp',
  'agent-skill': 'badge-skill',
  'plugin': 'badge-plugin',
  'browser-extension': 'badge-extension'
};
---

<Layout 
  title={`${title} - AgentHub Registry`}
  description={description}
>
  <div class="container detail-container">
    <!-- Back to browse link -->
    <a href="/" class="back-link" id="back-to-browse-btn">
      <ArrowLeft size={16} />
      <span>Back to Directory</span>
    </a>
    
    <!-- Detail Grid Layout -->
    <div class="detail-grid">
      <!-- Main Content Area -->
      <div class="main-content-column">
        <!-- Title Header Card -->
        <div class="detail-header-card glass-card">
          <div class="header-meta">
            <span class={`badge ${badgeClasses[category]}`}>
              {categoryLabels[category]}
            </span>
          </div>
          
          <div class="title-row">
            <div class={`title-icon-wrapper ${category}`}>
              <IconComponent size={32} />
            </div>
            <div class="title-meta">
              <h1 class="asset-title">{title}</h1>
              <p class="asset-description">{description}</p>
            </div>
          </div>
          
          <div class="action-row">
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary" id="github-source-link">
              <GitHub size={18} />
              <span>View Source on GitHub</span>
            </a>
            
            {installCommand && (
              <div class="copy-command-wrapper glass-panel">
                <code class="command-code" id="command-text">{installCommand}</code>
                <button class="copy-btn" id="copy-command-btn" aria-label="Copy installation command">
                  <Copy size={16} id="copy-icon" />
                  <Check size={16} id="check-icon" class="hide" />
                </button>
              </div>
            )}
          </div>
        </div>
        
        <!-- Markdown README Render Panel -->
        <div class="readme-panel glass-card">
          <h2 class="readme-title">Documentation & Installation</h2>
          <div class="markdown-body">
            <Content />
          </div>
        </div>
      </div>
      
      <!-- Sticky Sidebar Panel -->
      <aside class="sidebar-column">
        <div class="sticky-sidebar glass-card">
          <h3 class="sidebar-title">Asset Specification</h3>
          
          <div class="sidebar-section">
            <span class="section-label">Contributor</span>
            <a href={`https://github.com/${author}`} target="_blank" rel="noopener noreferrer" class="contributor-profile">
              <img 
                src={`https://github.com/${author}.png?size=80`} 
                alt={`${author}'s avatar`} 
                class="sidebar-avatar"
                onerror="this.src='https://github.com/identicons/default.png'"
              />
              <div class="contributor-details">
                <span class="contributor-username">@{author}</span>
                <span class="view-profile-text">GitHub Profile &rarr;</span>
              </div>
            </a>
          </div>
          
          <div class="sidebar-section">
            <span class="section-label">Agent Compatibility</span>
            <div class="agents-list">
              {compatibleAgents.map((agent) => (
                <span class="agent-tag">{agent}</span>
              ))}
            </div>
          </div>
          
          <div class="sidebar-section">
            <span class="section-label">Tags & Capabilities</span>
            <div class="tags-list">
              {tags.map((tag) => (
                <span class="tag-badge">#{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<!-- Client Side Copy Command Script -->
<script>
  const copyBtn = document.getElementById('copy-command-btn');
  const commandText = document.getElementById('command-text');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');

  if (copyBtn && commandText && copyIcon && checkIcon) {
    copyBtn.addEventListener('click', () => {
      const textToCopy = commandText.textContent || '';
      
      navigator.clipboard.writeText(textToCopy).then(() => {
        // Toggle icons
        copyIcon.classList.add('hide');
        checkIcon.classList.remove('hide');
        copyBtn.classList.add('success');
        
        // Reset after delay
        setTimeout(() => {
          copyIcon.classList.remove('hide');
          checkIcon.classList.add('hide');
          copyBtn.classList.remove('success');
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    });
  }
</script>

<style>
  .detail-container {
    padding-top: 40px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: hsl(var(--text-secondary));
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 30px;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .back-link:hover {
    color: white;
    transform: translateX(-3px);
  }

  /* Grid details */
  .detail-grid {
    display: grid;
    grid-template-columns: 2.5fr 1fr;
    gap: 30px;
    align-items: start;
    margin-bottom: 80px;
  }

  .main-content-column {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* Header card */
  .detail-header-card {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .header-meta {
    display: flex;
  }

  .title-row {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .title-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .title-icon-wrapper.mcp-server {
    color: rgb(34, 211, 238);
    background: rgba(6, 182, 212, 0.08);
    border-color: rgba(6, 182, 212, 0.25);
  }
  .title-icon-wrapper.agent-skill {
    color: rgb(167, 139, 250);
    background: rgba(139, 92, 246, 0.08);
    border-color: rgba(139, 92, 246, 0.25);
  }
  .title-icon-wrapper.plugin {
    color: rgb(251, 113, 133);
    background: rgba(244, 63, 94, 0.08);
    border-color: rgba(244, 63, 94, 0.25);
  }
  .title-icon-wrapper.browser-extension {
    color: rgb(253, 224, 71);
    background: rgba(234, 179, 8, 0.08);
    border-color: rgba(234, 179, 8, 0.25);
  }

  .title-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .asset-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.03em;
  }

  .asset-description {
    font-size: 1.1rem;
    color: hsl(var(--text-secondary));
    line-height: 1.5;
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 24px;
  }

  /* Copy Command area */
  .copy-command-wrapper {
    display: flex;
    align-items: center;
    border-radius: 12px;
    height: 48px;
    padding: 0 8px 0 16px;
    flex-grow: 1;
    max-width: 500px;
    overflow: hidden;
  }

  .command-code {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    color: hsl(var(--cyan-point));
    font-weight: 600;
    overflow-x: auto;
    white-space: nowrap;
    flex-grow: 1;
    margin-right: 12px;
  }
  /* Hide scrollbar for layout */
  .command-code::-webkit-scrollbar {
    display: none;
  }

  .copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: hsl(var(--text-secondary));
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .copy-btn:hover {
    color: white;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .copy-btn.success {
    color: rgb(34, 197, 94);
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
  }

  .copy-btn .hide {
    display: none;
  }

  /* Readme Documentation panel */
  .readme-panel {
    padding: 40px;
  }

  .readme-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: white;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 16px;
    margin-bottom: 24px;
  }

  /* Custom markdown styling targeting Content rendered elements */
  .markdown-body {
    line-height: 1.7;
    font-size: 1rem;
    color: hsl(var(--text-secondary));
  }

  .markdown-body :global(h2),
  .markdown-body :global(h3) {
    color: white;
    margin-top: 32px;
    margin-bottom: 16px;
  }
  
  .markdown-body :global(h2) {
    font-size: 1.3rem;
  }
  .markdown-body :global(h3) {
    font-size: 1.15rem;
  }

  .markdown-body :global(p) {
    margin-bottom: 16px;
  }

  .markdown-body :global(ul), 
  .markdown-body :global(ol) {
    margin-left: 20px;
    margin-bottom: 20px;
  }

  .markdown-body :global(li) {
    margin-bottom: 8px;
  }

  .markdown-body :global(code) {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 3px 6px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85em;
    color: hsl(var(--cyan-point));
  }

  .markdown-body :global(pre) {
    background: rgba(0, 0, 0, 0.3) !important;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 18px;
    margin: 20px 0;
    overflow-x: auto;
  }

  .markdown-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: white;
  }

  /* Sidebar styling */
  .sticky-sidebar {
    position: sticky;
    top: 102px; /* Header spacing */
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 12px;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: hsl(var(--text-muted));
  }

  /* contributor profile link */
  .contributor-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 10px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    transition: all 0.2s ease;
  }
  .contributor-profile:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .sidebar-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .contributor-details {
    display: flex;
    flex-direction: column;
  }

  .contributor-username {
    font-size: 0.85rem;
    font-weight: 600;
    color: white;
  }

  .view-profile-text {
    font-size: 0.75rem;
    color: hsl(var(--cyan-point));
  }

  /* tags & compatibility chips */
  .agents-list, .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .agent-tag {
    font-size: 0.8rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: white;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .tag-badge {
    font-size: 0.8rem;
    color: hsl(var(--text-secondary));
    background: rgba(6, 182, 212, 0.03);
    border: 1px solid rgba(6, 182, 212, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
  }

  @media (max-width: 992px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .sticky-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .detail-header-card {
      padding: 24px;
    }
    .title-row {
      flex-direction: column;
      gap: 16px;
    }
    .action-row {
      flex-direction: column;
      align-items: stretch;
    }
    .copy-command-wrapper {
      max-width: none;
    }
  }
</style>
