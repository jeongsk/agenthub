---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, CalendarDays, Clock3, Newspaper } from '@lucide/astro';
import { blogPosts, type BlogPost } from '../../lib/blog';
import { tagToSlug } from '../../lib/tags';

interface Props {
  post: BlogPost;
}

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout title={`${post.title} - AgentHub 블로그`} description={post.description}>
  <div class="container article-container">
    <a href="/blog" class="back-link">
      <ArrowLeft size={16} />
      <span>블로그로 돌아가기</span>
    </a>

    <article class="article-shell">
      <header class="article-header glass-panel">
        <div class="hero-badge">
          <Newspaper size={14} class="rose-icon" />
          <span>{post.category}</span>
        </div>
        <h1>{post.title}</h1>
        <p>{post.description}</p>
        <div class="article-meta">
          <span>
            <CalendarDays size={15} />
            {post.date}
          </span>
          <span>
            <Clock3 size={15} />
            {post.readTime}
          </span>
        </div>
        <div class="tag-list" aria-label={`${post.title} 태그`}>
          {post.tags.map((tag) => (
            <a class="tag-pill" href={`/tags/${tagToSlug(tag)}`}>#{tag}</a>
          ))}
        </div>
      </header>

      <div class="article-body glass-card markdown-body">
        {post.html ? (
          <div class="markdown-content" set:html={post.html} />
        ) : (
          post.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.bullets && (
                <ul>
                  {section.bullets.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </section>
          ))
        )}
      </div>
    </article>
  </div>
</Layout>

<style>
  .article-container {
    padding-top: 40px;
    margin-bottom: 80px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: hsl(var(--text-secondary));
    text-decoration: none;
    font-weight: 700;
    margin-bottom: 22px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: rgb(34, 211, 238);
  }

  .article-shell {
    max-width: 900px;
    margin: 0 auto;
  }

  .article-header {
    padding: 34px;
    margin-bottom: 24px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    color: rgb(251, 113, 133);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 22px;
  }

  .rose-icon {
    color: hsl(var(--rose-point));
  }

  .article-header h1 {
    font-size: 3rem;
    line-height: 1.16;
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .article-header p {
    color: hsl(var(--text-secondary));
    font-size: 1.08rem;
    line-height: 1.65;
    max-width: 760px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 22px;
    color: hsl(var(--text-muted));
    font-size: 0.92rem;
  }

  .article-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .tag-pill {
    color: hsl(var(--text-secondary));
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 9999px;
    padding: 5px 10px;
    font-size: 0.8rem;
  }

  a.tag-pill {
    text-decoration: none;
    transition: all 0.2s ease;
  }

  a.tag-pill:hover {
    color: white;
    border-color: rgba(6, 182, 212, 0.35);
    background: rgba(6, 182, 212, 0.1);
  }

  .article-body {
    padding: 34px;
  }

  .markdown-content {
    max-width: 720px;
    margin: 0 auto;
  }

  :global(.markdown-content > h1:first-child) {
    display: none;
  }

  :global(.markdown-content > * + *) {
    margin-top: 22px;
  }

  :global(.markdown-content h1) {
    font-size: 2.15rem;
    line-height: 1.2;
    margin-top: 8px;
    margin-bottom: 16px;
  }

  :global(.markdown-content h2) {
    font-size: 1.55rem;
    line-height: 1.35;
    margin-top: 30px;
    margin-bottom: 14px;
  }

  :global(.markdown-content h3) {
    font-size: 1.2rem;
    line-height: 1.45;
    margin-top: 26px;
    margin-bottom: 10px;
  }

  :global(.markdown-content p) {
    color: hsl(var(--text-secondary));
    line-height: 1.9;
    font-size: 1.02rem;
    overflow-wrap: break-word;
  }

  :global(.markdown-content a) {
    color: rgb(34, 211, 238);
    text-decoration-color: rgba(34, 211, 238, 0.42);
    text-underline-offset: 3px;
  }

  :global(.markdown-content blockquote) {
    margin: 18px 0;
    padding: 18px 20px;
    border-left: 3px solid rgba(6, 182, 212, 0.7);
    background: rgba(255, 255, 255, 0.03);
    border-radius: 10px;
    color: hsl(var(--text-secondary));
  }

  :global(.markdown-content blockquote p) {
    margin: 0;
  }

  :global(.markdown-content ul),
  :global(.markdown-content ol) {
    margin: 16px 0;
    padding-left: 22px;
    color: hsl(var(--text-secondary));
    line-height: 1.85;
  }

  :global(.markdown-content li + li) {
    margin-top: 8px;
  }

  :global(.markdown-content img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: min(62vh, 560px);
    height: auto;
    object-fit: contain;
    margin: 30px auto 10px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.markdown-content p:has(> img) > em) {
    display: block;
    color: hsl(var(--text-muted));
    text-align: center;
    font-size: 0.95rem;
    margin-top: 8px;
  }

  :global(.markdown-content table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 20px 0;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.markdown-content th),
  :global(.markdown-content td) {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: left;
    vertical-align: top;
    line-height: 1.65;
  }

  :global(.markdown-content th) {
    background: rgba(255, 255, 255, 0.04);
    color: hsl(var(--text-primary));
    font-weight: 700;
  }

  :global(.markdown-content tr:last-child td) {
    border-bottom: none;
  }

  :global(.markdown-content pre) {
    overflow-x: auto;
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.markdown-content code) {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
    padding: 2px 5px;
    color: white;
  }

  :global(.markdown-content pre code) {
    background: transparent;
    padding: 0;
  }

  :global(.markdown-content hr) {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 28px 0;
  }

  .article-body section + section {
    margin-top: 34px;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .article-body h2 {
    font-size: 1.45rem;
    margin-bottom: 14px;
  }

  .article-body p {
    color: hsl(var(--text-secondary));
    line-height: 1.8;
    font-size: 1rem;
  }

  .article-body p + p {
    margin-top: 12px;
  }

  .article-body ul {
    margin-top: 16px;
    padding-left: 20px;
    color: hsl(var(--text-secondary));
    line-height: 1.75;
  }

  .article-body li + li {
    margin-top: 8px;
  }

  code {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
    padding: 2px 5px;
    color: white;
  }

  @media (max-width: 640px) {
    .article-container {
      padding-top: 28px;
    }

    .article-header,
    .article-body {
      padding: 24px;
    }

    .article-header h1 {
      font-size: 2.05rem;
      overflow-wrap: keep-all;
    }

    :global(.markdown-content h2) {
      font-size: 1.35rem;
    }

    :global(.markdown-content p) {
      font-size: 1rem;
      line-height: 1.82;
    }
  }
</style>
