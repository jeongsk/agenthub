---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Copy, ExternalLink, Globe, Star } from '@lucide/astro';
import { getCollection, render } from 'astro:content';
import GitHub from '../../components/icons/GitHub.astro';
import { formatStarCount } from '../../lib/github';
import { categoryLabel, isGitHubUrl, CATEGORIES } from '../../lib/registry';
import { tagToSlug } from '../../lib/tags';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map((skill) => ({
    params: { slug: skill.id },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);
const data = skill.data;
const catCfg = CATEGORIES[data.category];
---
<Layout title={`${data.title} - AgentHub Registry`} description={data.description}>
  <div class="container detail-container">
    <a href="/" class="back-link" id="directory-back-link">
      <ArrowLeft size={16} />
      <span>디렉토리로 돌아가기</span>
    </a>

    <div class="detail-grid">
      <div class="main-content-column">
        <div class="detail-header-card glass-card">
          <div class="header-meta">
            <span class="badge" style={`--badge-color: ${catCfg.color}; --badge-bg: ${catCfg.bg}; --badge-border: ${catCfg.border};`}>{categoryLabel(data.category)}</span>
            {data.githubStars > 0 && isGitHubUrl(data.githubUrl) && (
              <span class="stars-pill" title="GitHub stars">
                <Star size={14} />
                <span>{formatStarCount(data.githubStars)}</span>
              </span>
            )}
          </div>

          <div class="title-row">
            <div class="title-icon-wrapper" style={`color: ${catCfg.color}; background: ${catCfg.bg}; border-color: ${catCfg.border};`} aria-hidden="true">{data.icon.slice(0, 2)}</div>
            <div class="title-meta">
              <h1 class="asset-title">{data.title}</h1>
              <p class="asset-description">{data.description}</p>
            </div>
          </div>

          <div class="action-row">
            {isGitHubUrl(data.githubUrl) ? (
              <a href={data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                <GitHub size={18} />
                <span>GitHub 저장소 보기</span>
              </a>
            ) : (
              <a href={data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                <Globe size={18} />
                <span>웹사이트 방문하기</span>
              </a>
            )}
            {data.websiteUrl && (
              <a href={data.websiteUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                <ExternalLink size={18} />
                <span>웹사이트 방문하기</span>
              </a>
            )}
            {data.chromeWebStoreUrl && (
              <a href={data.chromeWebStoreUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                <ExternalLink size={18} />
                <span>Chrome Web Store 열기</span>
              </a>
            )}
            {data.installCommand && (
              <div class="copy-command-wrapper glass-panel">
                <code class="command-code" id="command-text">{data.installCommand}</code>
                <button class="copy-btn" id="copy-command-btn" aria-label="설치 명령어 복사">
                  <Copy size={16} />
                </button>
              </div>
            )}
          </div>
        </div>

        <div class="readme-panel glass-card">
          <h2 class="readme-title">문서 & 설치 가이드</h2>
          <div class="markdown-body">
            <Content />
          </div>
        </div>
      </div>

      <aside class="sidebar-column">
        <div class="sticky-sidebar glass-card">
          <h3 class="sidebar-title">에셋 정보</h3>

          <div class="sidebar-section">
            <span class="section-label">기여자</span>
            <a href={`https://github.com/${encodeURIComponent(data.author)}`} target="_blank" rel="noopener noreferrer" class="contributor-profile">
              <img src={`https://github.com/${encodeURIComponent(data.author)}.png?size=80`} alt={`${data.author} GitHub 아바타`} class="sidebar-avatar" />
              <div class="contributor-details">
                <span class="contributor-username">@{data.author}</span>
                <span class="view-profile-text">GitHub 프로필 보기</span>
              </div>
            </a>
          </div>

          {isGitHubUrl(data.githubUrl) && (
          <div class="sidebar-section">
            <span class="section-label">GitHub Stars</span>
            <a href={data.githubUrl} target="_blank" rel="noopener noreferrer" class="stat-link">
              <Star size={16} />
              <span>{formatStarCount(data.githubStars)}</span>
            </a>
          </div>
          )}

          <div class="sidebar-section">
            <span class="section-label">호환 에이전트</span>
            <div class="agents-list">
              {data.compatibleAgents.map((agent) => <span class="agent-tag">{agent}</span>)}
            </div>
          </div>

          <div class="sidebar-section">
            <span class="section-label">태그</span>
            <div class="tags-list">
              {data.tags.map((tag) => <a class="tag-badge" href={`/tags/${tagToSlug(tag)}`}>#{tag}</a>)}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-command-btn');
  const commandText = document.getElementById('command-text');
  const directoryBackLink = document.getElementById('directory-back-link') as HTMLAnchorElement | null;
  const returnToDirectoryKey = 'agenthub:return-to-directory';

  if (copyBtn && commandText) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(commandText.textContent || '').then(() => {
        copyBtn.classList.add('success');
        setTimeout(() => copyBtn.classList.remove('success'), 1600);
      });
    });
  }

  if (directoryBackLink) {
    const fallbackPath = sessionStorage.getItem(returnToDirectoryKey);

    if (fallbackPath?.startsWith('/')) {
      directoryBackLink.href = fallbackPath;
    }

    directoryBackLink.addEventListener('click', (event) => {
      const referrerUrl = document.referrer ? new URL(document.referrer) : null;
      const cameFromDirectory =
        referrerUrl?.origin === window.location.origin &&
        referrerUrl.pathname === '/';

      if (cameFromDirectory && window.history.length > 1) {
        event.preventDefault();
        window.history.back();
      }
    });
  }
</script>

<style>
  .detail-container { padding-top: 40px; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: hsl(var(--text-secondary));
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 30px;
  }
  .back-link:hover { color: hsl(var(--text-primary)); }
  .detail-grid {
    display: grid;
    grid-template-columns: 2.5fr 1fr;
    gap: 30px;
    align-items: start;
    margin-bottom: 80px;
  }
  .main-content-column {
    display: flex;
    flex-direction: column;
    gap: 30px;
    min-width: 0;
  }
  .detail-header-card {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stars-pill, .stat-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgb(253, 224, 71);
    background: rgba(234, 179, 8, 0.08);
    border: 1px solid rgba(234, 179, 8, 0.2);
    border-radius: 9999px;
    font-weight: 700;
  }
  .stars-pill {
    padding: 4px 10px;
    font-size: 0.78rem;
  }
  .stat-link {
    width: fit-content;
    padding: 9px 12px;
    text-decoration: none;
  }
  .stat-link:hover {
    border-color: rgba(234, 179, 8, 0.42);
    background: rgba(234, 179, 8, 0.13);
  }
  .title-row { display: flex; gap: 20px; align-items: flex-start; }
  .title-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    flex-shrink: 0;
    border: 1px solid var(--border-subtle);
    font-weight: 800;
    font-size: 1.2rem;
  }
  .title-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .asset-title { font-size: 2.2rem; font-weight: 800; color: hsl(var(--text-primary)); }
  .asset-description {
    font-size: 1.05rem;
    color: hsl(var(--text-secondary));
    line-height: 1.55;
  }
  .action-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .copy-command-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .command-code {
    display: block;
    min-width: 0;
    flex: 1 1 auto;
    overflow-x: auto;
    color: hsl(var(--text-secondary));
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .copy-btn {
    border: 0;
    border-radius: 8px;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: var(--surface-subtle);
    color: hsl(var(--text-primary));
    flex: 0 0 auto;
  }
  .copy-btn.success { color: rgb(var(--accent-cyan-link)); }
  .readme-panel, .sticky-sidebar {
    padding: 30px;
    min-width: 0;
  }
  .readme-title { font-size: 1.3rem; margin-bottom: 18px; }
  .markdown-body {
    color: hsl(var(--text-secondary));
    line-height: 1.75;
    min-width: 0;
  }
  .markdown-body :global(h1), .markdown-body :global(h2), .markdown-body :global(h3) {
    color: hsl(var(--text-primary));
    margin: 1.2em 0 0.5em;
  }
  .markdown-body :global(p), .markdown-body :global(ul), .markdown-body :global(pre) { margin-bottom: 1em; }
  .markdown-body :global(ul), .markdown-body :global(ol) { padding-left: 1.2rem; }
  .markdown-body :global(code) {
    background: var(--surface-subtle);
    border-radius: 6px;
    padding: 2px 5px;
    color: hsl(var(--text-primary));
  }
  .markdown-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 16px;
    border-radius: 12px;
    background: var(--surface-code);
    border: 1px solid var(--border-subtle);
  }
  .markdown-body :global(pre code) { background: transparent; padding: 0; }
  .markdown-body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: min(62vh, 560px);
    height: auto;
    object-fit: contain;
    margin: 20px auto;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }
  .sidebar-column { position: sticky; top: 110px; }
  .sticky-sidebar { display: flex; flex-direction: column; gap: 24px; }
  .sidebar-title { font-size: 1.1rem; }
  .sidebar-section { display: flex; flex-direction: column; gap: 10px; }
  .section-label {
    font-size: 0.76rem;
    font-weight: 700;
    color: hsl(var(--text-muted));
    text-transform: uppercase;
  }
  .contributor-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }
  .sidebar-avatar { width: 44px; height: 44px; border-radius: 50%; }
  .contributor-details { display: flex; flex-direction: column; gap: 2px; }
  .contributor-username { font-weight: 700; }
  .view-profile-text { color: hsl(var(--text-muted)); font-size: 0.82rem; }
  .agents-list, .tags-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .agent-tag, .tag-badge {
    font-size: 0.78rem;
    color: hsl(var(--text-secondary));
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 7px;
    padding: 5px 8px;
  }
  a.tag-badge {
    text-decoration: none;
    transition: all 0.2s ease;
  }
  a.tag-badge:hover {
    color: hsl(var(--text-primary));
    border-color: rgb(var(--accent-cyan) / 0.35);
    background: rgb(var(--accent-cyan) / 0.08);
  }
  @media (max-width: 900px) {
    .detail-grid { grid-template-columns: 1fr; }
    .sidebar-column { position: static; }
  }
  @media (max-width: 640px) {
    .detail-header-card, .readme-panel, .sticky-sidebar { padding: 22px; }
    .title-row { flex-direction: column; }
    .asset-title { font-size: 1.8rem; }
    .copy-command-wrapper { align-items: flex-start; }
    .command-code {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }
</style>
