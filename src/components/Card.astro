---
import * as Icons from '@lucide/astro';
import { ArrowUpRight, Star } from '@lucide/astro';
import { formatStarCount } from '../lib/github';
import { CATEGORIES, categoryLabel, categoryColor, categoryBg } from '../lib/registry';
import { tagToSlug } from '../lib/tags';

interface Props {
  title: string;
  description: string;
  category: 'mcp-server' | 'agent-skill' | 'agent-framework' | 'agent-harness' | 'agent-component' | 'desktop-utility' | 'cli-utility' | 'plugin' | 'browser-extension' | 'web-app';
  tags: string[];
  author: string;
  compatibleAgents: string[];
  icon: string;
  slug: string;
  stars?: number | null;
  featured?: boolean;
}

const { title, description, category, tags, author, compatibleAgents, icon, slug, stars, featured } = Astro.props;

// Dynamically select Lucide icon component based on string input
const IconComponent = (Icons as any)[icon] || Icons.Terminal;

const cfg = CATEGORIES[category];
const pointColor = cfg?.color ?? 'rgb(var(--cat-cli-utility))';
const pointBg = cfg?.bg ?? 'var(--surface-subtle)';
const pointBorder = cfg?.border ?? 'var(--border-subtle)';
---

<article class="glass-card tool-card">
  <a href={`/tools/${slug}`} class="card-link" aria-label={`View details for ${title}`}>
    <div class="card-header">
      <div class="card-icon-wrapper" style={`color: ${pointColor}; background: ${pointBg}; border-color: ${pointBorder};`}>
        <IconComponent size={22} />
      </div>
      <div class="header-badges">
        {featured && <span class="featured-pill">추천</span>}
        <span class="badge" style={`--badge-color: ${pointColor}; --badge-bg: ${pointBg}; --badge-border: ${pointBorder};`}>
          {categoryLabel(category)}
        </span>
        <span class="stars-pill" title="GitHub stars">
          <Star size={14} />
          <span>{formatStarCount(stars)}</span>
        </span>
      </div>
    </div>
    
    <div class="card-body">
      <h3 class="card-title">
        {title}
        <ArrowUpRight size={16} class="arrow-icon" />
      </h3>
      <p class="card-description">{description}</p>
    </div>
  </a>

  <div class="card-tags">
    {tags.slice(0, 3).map((tag) => (
      <a href={`/tags/${tagToSlug(tag)}`} class="tag-chip">#{tag}</a>
    ))}
    {tags.length > 3 && <span class="tag-chip muted">+{tags.length - 3}</span>}
  </div>

  <div class="card-footer">
      <div class="author-info">
        <img 
          src={`https://github.com/${author}.png?size=40`} 
          alt={`GitHub Avatar of ${author}`} 
          class="author-avatar" 
          loading="lazy"
          onerror="this.src='https://github.com/identicons/default.png'"
        />
        <span class="author-name">{author}</span>
      </div>
      
      <div class="compatibility-list">
        {compatibleAgents.map((agent) => (
          <span class="agent-chip" title={`Compatible with ${agent}`}>{agent}</span>
        ))}
      </div>
  </div>
</article>

<style>
  .tool-card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 24px;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 20px;
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    min-width: 0;
  }

  .featured-pill {
    display: inline-flex;
    align-items: center;
    color: rgb(255, 255, 255);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.95), rgba(236, 72, 153, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
    padding: 4px 10px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.18);
  }

  .stars-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgb(253, 224, 71);
    background: rgba(234, 179, 8, 0.08);
    border: 1px solid rgba(234, 179, 8, 0.2);
    border-radius: 9999px;
    padding: 4px 10px;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border-radius: 12px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s ease;
  }

  .tool-card:hover .card-icon-wrapper {
    transform: scale(1.08);
  }

  .card-body {
    flex-grow: 1;
    margin-bottom: 16px;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: hsl(var(--text-primary));
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }

  .arrow-icon {
    flex: 0 0 auto;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: hsl(var(--text-muted));
  }

  .tool-card:hover .arrow-icon {
    opacity: 1;
    transform: translate(0, 0);
    color: rgb(var(--accent-cyan-link));
  }

  .card-description {
    font-size: 0.9rem;
    color: hsl(var(--text-secondary));
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .tag-chip {
    min-width: 0;
    max-width: 100%;
    font-size: 0.75rem;
    color: hsl(var(--text-muted));
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    padding: 3px 8px;
    border-radius: 6px;
    transition: all 0.2s ease;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  a.tag-chip:hover {
    color: hsl(var(--text-primary));
    border-color: rgb(var(--accent-cyan) / 0.35);
    background: rgb(var(--accent-cyan) / 0.08);
  }
  .tag-chip.muted {
    opacity: 0.6;
  }

  .card-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
  }

  .author-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: hsl(var(--text-secondary));
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-card:hover .author-name {
    color: hsl(var(--text-primary));
  }

  .compatibility-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
    min-width: 0;
  }

  .agent-chip {
    font-size: 0.7rem;
    font-weight: 600;
    color: hsl(var(--text-muted));
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }

  .tool-card:hover .agent-chip {
    color: hsl(var(--text-primary));
    border-color: var(--border-strong);
  }

  @media (max-width: 640px) {
    .tool-card {
      padding: 18px;
    }

    .card-header {
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .header-badges {
      max-width: calc(100% - 58px);
    }

    .badge {
      white-space: normal;
      text-align: right;
      overflow-wrap: anywhere;
    }

    .card-title {
      font-size: 1.05rem;
      line-height: 1.3;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .compatibility-list {
      justify-content: flex-start;
      width: 100%;
    }
  }
</style>
