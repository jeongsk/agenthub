---
import * as Icons from '@lucide/astro';
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  category: 'mcp-server' | 'agent-skill' | 'agent-harness' | 'desktop-utility' | 'plugin' | 'browser-extension';
  tags: string[];
  author: string;
  compatibleAgents: string[];
  icon: string;
  slug: string;
}

const { title, description, category, tags, author, compatibleAgents, icon, slug } = Astro.props;

// Dynamically select Lucide icon component based on string input
const IconComponent = (Icons as any)[icon] || Icons.Terminal;

// Generate beautiful category display text
const categoryLabels = {
  'mcp-server': 'MCP Server',
  'agent-skill': 'Agent Skill',
  'agent-harness': 'Agent Harness',
  'desktop-utility': 'Desktop Utility',
  'plugin': 'Plugin',
  'browser-extension': 'Extension'
};

const badgeClasses = {
  'mcp-server': 'badge-mcp',
  'agent-skill': 'badge-skill',
  'agent-harness': 'badge-harness',
  'desktop-utility': 'badge-utility',
  'plugin': 'badge-plugin',
  'browser-extension': 'badge-extension'
};
---

<article class="glass-card tool-card">
  <a href={`/skills/${slug}`} class="card-link" aria-label={`View details for ${title}`}>
    <div class="card-header">
      <div class={`card-icon-wrapper ${category}`}>
        <IconComponent size={22} />
      </div>
      <span class={`badge ${badgeClasses[category]}`}>
        {categoryLabels[category]}
      </span>
    </div>
    
    <div class="card-body">
      <h3 class="card-title">
        {title}
        <ArrowUpRight size={16} class="arrow-icon" />
      </h3>
      <p class="card-description">{description}</p>
    </div>
    
    <div class="card-tags">
      {tags.slice(0, 3).map((tag) => (
        <span class="tag-chip">#{tag}</span>
      ))}
      {tags.length > 3 && <span class="tag-chip muted">+{tags.length - 3}</span>}
    </div>
    
    <div class="card-footer">
      <div class="author-info">
        <img 
          src={`https://github.com/${author}.png?size=40`} 
          alt={`GitHub Avatar of ${author}`} 
          class="author-avatar" 
          loading="lazy"
          onerror="this.src='https://github.com/identicons/default.png'"
        />
        <span class="author-name">{author}</span>
      </div>
      
      <div class="compatibility-list">
        {compatibleAgents.map((agent) => (
          <span class="agent-chip" title={`Compatible with ${agent}`}>{agent}</span>
        ))}
      </div>
    </div>
  </a>
</article>

<style>
  .tool-card {
    position: relative;
    height: 100%;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    padding: 24px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.3s ease;
  }

  /* Dynamic point-color styling based on category */
  .card-icon-wrapper.mcp-server {
    color: rgb(34, 211, 238);
    background: rgba(6, 182, 212, 0.06);
    border-color: rgba(6, 182, 212, 0.15);
  }
  .card-icon-wrapper.agent-skill {
    color: rgb(167, 139, 250);
    background: rgba(139, 92, 246, 0.06);
    border-color: rgba(139, 92, 246, 0.15);
  }
  .card-icon-wrapper.agent-harness {
    color: rgb(45, 212, 191);
    background: rgba(20, 184, 166, 0.06);
    border-color: rgba(20, 184, 166, 0.15);
  }
  .card-icon-wrapper.desktop-utility {
    color: rgb(251, 191, 36);
    background: rgba(245, 158, 11, 0.06);
    border-color: rgba(245, 158, 11, 0.15);
  }
  .card-icon-wrapper.plugin {
    color: rgb(251, 113, 133);
    background: rgba(244, 63, 94, 0.06);
    border-color: rgba(244, 63, 94, 0.15);
  }
  .card-icon-wrapper.browser-extension {
    color: rgb(253, 224, 71);
    background: rgba(234, 179, 8, 0.06);
    border-color: rgba(234, 179, 8, 0.15);
  }

  .tool-card:hover .card-icon-wrapper {
    transform: scale(1.08);
  }

  .card-body {
    flex-grow: 1;
    margin-bottom: 16px;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: white;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }

  .arrow-icon {
    flex: 0 0 auto;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: hsl(var(--text-muted));
  }

  .tool-card:hover .arrow-icon {
    opacity: 1;
    transform: translate(0, 0);
    color: hsl(var(--cyan-point));
  }

  .card-description {
    font-size: 0.9rem;
    color: hsl(var(--text-secondary));
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .tag-chip {
    min-width: 0;
    max-width: 100%;
    font-size: 0.75rem;
    color: hsl(var(--text-muted));
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 6px;
    transition: all 0.2s ease;
    overflow-wrap: anywhere;
  }
  .tag-chip:hover {
    color: white;
    background: rgba(255, 255, 255, 0.05);
  }
  .tag-chip.muted {
    opacity: 0.6;
  }

  .card-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .author-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: hsl(var(--text-secondary));
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-card:hover .author-name {
    color: white;
  }

  .compatibility-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
    min-width: 0;
  }

  .agent-chip {
    font-size: 0.7rem;
    font-weight: 600;
    color: hsl(var(--text-muted));
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 2px 6px;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }

  .tool-card:hover .agent-chip {
    color: white;
    border-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 640px) {
    .card-link {
      padding: 18px;
    }

    .card-header {
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .badge {
      white-space: normal;
      text-align: right;
      overflow-wrap: anywhere;
    }

    .card-title {
      font-size: 1.05rem;
      line-height: 1.3;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .compatibility-list {
      justify-content: flex-start;
      width: 100%;
    }
  }
</style>
