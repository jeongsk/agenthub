---
import { Terminal, Sun, Moon, Monitor } from '@lucide/astro';
import GitHub from './icons/GitHub.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header class="main-header glass-panel">
  <div class="container header-container">
    <a href="/" class="logo" id="header-logo-link">
      <div class="logo-icon">
        <Terminal size={20} class="cyan-icon" />
      </div>
      <span class="logo-text">Agent<span class="text-gradient">Hub</span></span>
    </a>
    
    <nav class="nav-links">
      <a href="/" class:list={['nav-link', { active: isActive('/') }]} id="nav-home">둘러보기</a>
      <a href="/tags" class:list={['nav-link', { active: isActive('/tags') }]} id="nav-tags">태그</a>
      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]} id="nav-blog">블로그</a>
      <a href="https://github.com/jeongsk/agenthub" target="_blank" rel="noopener noreferrer" class="nav-icon-link" aria-label="GitHub Repository">
        <GitHub size={20} />
      </a>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="테마 전환" title="테마 전환">
        <Monitor size={20} class="ti ti-system" />
        <Sun size={20} class="ti ti-light" />
        <Moon size={20} class="ti ti-dark" />
      </button>
    </nav>
  </div>
</header>

<script>
  const KEY = 'agenthub:theme';
  const ORDER = ['system', 'light', 'dark'] as const;
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const mql = window.matchMedia('(prefers-color-scheme: dark)');

  type Mode = (typeof ORDER)[number];

  function read(): Mode {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' ? v : 'system';
    } catch {
      return 'system';
    }
  }

  function effective(mode: Mode) {
    return mode === 'system' ? (mql.matches ? 'dark' : 'light') : mode;
  }

  function applyDOM(mode: Mode) {
    if (mode === 'light' || mode === 'dark') root.setAttribute('data-theme', mode);
    else root.removeAttribute('data-theme');
  }

  function syncMeta(mode: Mode) {
    const eff = effective(mode);
    let m = document.querySelector('meta[name="theme-color"]:not([media])');
    if (!m) {
      m = document.createElement('meta');
      m.setAttribute('name', 'theme-color');
      document.head.appendChild(m);
    }
    m.setAttribute('content', eff === 'dark' ? '#0c0e14' : '#f3f5fa');
  }

  function syncIcon(mode: Mode) {
    if (!btn) return;
    btn.classList.remove('is-system', 'is-light', 'is-dark');
    btn.classList.add('is-' + mode);
    const label =
      mode === 'system'
        ? '테마: 시스템 (클릭하면 라이트)'
        : mode === 'light'
          ? '테마: 라이트 (클릭하면 다크)'
          : '테마: 다크 (클릭하면 시스템)';
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
  }

  function render(mode: Mode) {
    applyDOM(mode);
    syncIcon(mode);
    syncMeta(mode);
  }

  render(read());

  if (btn) {
    btn.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length];
      try {
        localStorage.setItem(KEY, next);
      } catch {}
      render(next);
    });
  }

  mql.addEventListener('change', () => {
    if (read() === 'system') syncMeta('system');
  });
</script>

<style>
  .main-header {
    position: fixed;
    top: 16px;
    left: 16px;
    right: 16px;
    height: 70px;
    z-index: 100;
    border-radius: 20px !important;
    display: flex;
    align-items: center;
  }

  .header-container {
    width: 100%;
    max-width: none;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 24px;
    min-width: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    color: hsl(var(--text-primary));
    font-size: 1.35rem;
    font-weight: 800;
    font-family: 'Outfit', sans-serif;
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgb(var(--accent-cyan) / 0.1);
    border: 1px solid rgb(var(--accent-cyan) / 0.25);
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .logo:hover .logo-icon {
    transform: rotate(10deg) scale(1.05);
    background: rgb(var(--accent-cyan) / 0.15);
    border-color: rgb(var(--accent-cyan) / 0.4);
    box-shadow: 0 0 10px rgb(var(--accent-cyan) / 0.2);
  }

  .cyan-icon {
    color: rgb(var(--accent-cyan-link));
  }

  .logo-text {
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .nav-links {
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 30px;
    min-width: 0;
  }

  .nav-link {
    color: hsl(var(--text-secondary));
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: hsl(var(--text-primary));
  }

  .nav-link.active {
    position: relative;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    border-radius: 9999px;
    background: var(--grad-primary);
    box-shadow: 0 0 12px rgb(var(--accent-cyan) / 0.35);
  }

  .nav-icon-link {
    color: hsl(var(--text-secondary));
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
  }

  .nav-icon-link:hover {
    color: hsl(var(--text-primary));
    transform: scale(1.05);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: none;
    border: none;
    color: hsl(var(--text-secondary));
    cursor: pointer;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .theme-toggle:hover {
    color: hsl(var(--text-primary));
    transform: scale(1.05);
  }
  .theme-toggle .ti-light,
  .theme-toggle .ti-dark {
    display: none;
  }
  .theme-toggle.is-light .ti-system,
  .theme-toggle.is-dark .ti-system {
    display: none;
  }
  .theme-toggle.is-light .ti-light {
    display: block;
  }
  .theme-toggle.is-dark .ti-dark {
    display: block;
  }

  /* Responsive styles */
  @media (max-width: 640px) {
    .main-header {
      left: 12px;
      right: 12px;
      height: 64px;
      border-radius: 18px !important;
    }
    .header-container {
      display: flex;
      justify-content: space-between;
      padding: 0 14px;
      gap: 12px;
    }
    .logo {
      gap: 8px;
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .logo-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
    }
    .nav-links {
      gap: 12px;
      justify-content: flex-end;
      flex: 1;
    }
    .nav-link {
      font-size: 0.88rem;
      white-space: nowrap;
    }
  }

  @media (max-width: 390px) {
    .main-header {
      left: 10px;
      right: 10px;
    }
    .header-container {
      padding: 0 12px;
      gap: 10px;
    }
    .logo-text {
      max-width: 116px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nav-links {
      gap: 10px;
    }
    .nav-link {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 360px) {
    .logo-text {
      display: none;
    }

    .nav-links {
      gap: 8px;
    }
  }
</style>
