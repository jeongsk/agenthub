---
import { Terminal, Plus } from '@lucide/astro';
import GitHub from './icons/GitHub.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header class="main-header glass-panel">
  <div class="container header-container">
    <a href="/" class="logo" id="header-logo-link">
      <div class="logo-icon">
        <Terminal size={20} class="cyan-icon" />
      </div>
      <span class="logo-text">Agent<span class="text-gradient">Hub</span></span>
    </a>
    
    <nav class="nav-links">
      <a href="/" class:list={['nav-link', { active: isActive('/') }]} id="nav-home">둘러보기</a>
      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]} id="nav-blog">블로그</a>
      <a href="/submit" class:list={['nav-link', { active: isActive('/submit') }]} id="nav-submit-guide">등록하기</a>
      <a href="https://github.com/jeongsk/agenthub" target="_blank" rel="noopener noreferrer" class="nav-icon-link" aria-label="GitHub Repository">
        <GitHub size={20} />
      </a>
    </nav>
    
    <div class="header-action">
      <a href="/submit" class="btn-grad text-sm" id="header-submit-btn">
        <Plus size={16} />
        <span>스킬 등록</span>
      </a>
    </div>
  </div>
</header>

<style>
  .main-header {
    position: fixed;
    top: 16px;
    left: 16px;
    right: 16px;
    height: 70px;
    z-index: 100;
    border-radius: 20px !important;
    display: flex;
    align-items: center;
  }

  .header-container {
    width: 100%;
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 24px;
    min-width: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    color: white;
    font-size: 1.35rem;
    font-weight: 800;
    font-family: 'Outfit', sans-serif;
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .logo:hover .logo-icon {
    transform: rotate(10deg) scale(1.05);
    background: rgba(6, 182, 212, 0.15);
    border-color: rgba(6, 182, 212, 0.4);
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.2);
  }

  .cyan-icon {
    color: hsl(var(--cyan-point));
  }

  .logo-text {
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
    min-width: 0;
  }

  .nav-link {
    color: hsl(var(--text-secondary));
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: hsl(var(--text-primary));
  }

  .nav-link.active {
    position: relative;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    border-radius: 9999px;
    background: var(--grad-primary);
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.35);
  }

  .nav-icon-link {
    color: hsl(var(--text-secondary));
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
  }

  .nav-icon-link:hover {
    color: white;
    transform: scale(1.05);
  }

  .header-action {
    display: flex;
    align-items: center;
  }

  .header-action .btn-grad {
    color: white !important;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .header-action .btn-grad span,
  .header-action .btn-grad svg {
    color: white !important;
  }

  .text-sm {
    padding: 8px 16px;
    font-size: 0.85rem;
    border-radius: 10px;
  }

  /* Responsive styles */
  @media (max-width: 640px) {
    .main-header {
      left: 12px;
      right: 12px;
      height: 64px;
      border-radius: 18px !important;
    }
    .header-container {
      padding: 0 14px;
      gap: 12px;
    }
    .logo {
      gap: 8px;
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .logo-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
    }
    .nav-links {
      gap: 12px;
      justify-content: flex-end;
      flex: 1;
    }
    .nav-link {
      font-size: 0.88rem;
      white-space: nowrap;
    }
    .header-action {
      display: none; /* hide CTA button on mobile */
    }
  }

  @media (max-width: 390px) {
    .main-header {
      left: 10px;
      right: 10px;
    }
    .header-container {
      padding: 0 12px;
      gap: 10px;
    }
    .logo-text {
      max-width: 116px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nav-links {
      gap: 10px;
    }
    .nav-link {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 360px) {
    .logo-text {
      display: none;
    }

    .nav-links {
      gap: 8px;
    }
  }
</style>
